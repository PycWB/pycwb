# Source before launching a native PycWB background job. See docs/dev/background_performance.md.
# Keep each setting explicit so inherited experiment variables cannot change this profile.
export PYCWB_TILED_WDM=1
export WDM_BOUNDED_JAX_INVERSE=1
export WDM_BOUNDED_JAX_FORWARD=1
export PYCWB_BOUNDED_JAX_MAX_ENERGY=1
export PYCWB_MAX_ENERGY_BACKEND=jax
export WDM_BOUNDED_NUMBA=0
export PYCWB_DIRECT_MAX_ENERGY_INPUT=0
export PYCWB_STAGED_TD=1
export PYCWB_COMPACT_TD_CACHE=1
export PYCWB_BAND_TD_CACHE=0
export PYCWB_COHERENCE_EARLY_CUTS=1
export PYCWB_PREINDEX_SHIFTS=1
export PYCWB_CLUSTER_RUNS=1
export PYCWB_SCALAR_DPF=1
export PYCWB_SKY_DELAY_REUSE=1
export PYCWB_COMPACT_COHERENCE=1
export PYCWB_GC_FULL_INTERVAL=16
# These are scientific release-compatibility corrections, not workspace toggles.
export PYCWB_REGRESSION_CAP=1
export PYCWB_NATIVE_CHIRP=1
export PYCWB_RELEASE_WAVEFORM_STATS=1
# GPU use requires its separately validated deterministic inverse profile.
export JAX_PLATFORMS=cpu
export PYCWB_REQUIRE_GPU=0
export WDM_DETERMINISTIC_JAX_INVERSE=0
