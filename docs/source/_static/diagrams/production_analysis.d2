# Production analysis overview (standard_analysis.rst).
direction: down

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 1
    pad: 24
  }
}

style: {
  fill: "#ffffff"
  stroke: "#455a64"
  stroke-width: 2
  border-radius: 8
  font-color: "#263238"
  font-size: 13
  shadow: true
}

setup: "Standard analysis setup\npycWB environment + config template" {style.fill: "#fff3e0"}

runs: "Production runs" {
  label.near: top-left
  style.font-size: 14
  style.fill: "#f5f5f5"
  style.stroke: "#90a4ae"
  style.stroke-dash: 1

  background: "Background\n(zero-lag + time slides)" {style.fill: "#e3f2fd"}
  training: "Training-set\nsimulations" {style.fill: "#e8f5e9"}
  simulations: "Evaluation\nsimulations" {style.fill: "#fce4ec"}
}

setup -> runs.background
setup -> runs.training
setup -> runs.simulations

# postproduction
model: "XGBoost\nmodel training" {style.fill: "#f3e5f5"}
far: "Background statistics\nFAR(ρ)" {style.fill: "#e8eaf6"}
sensitivity: "Sensitivity study\ndetection efficiency" {style.fill: "#e8f5e9"}
openbox: "Open box /\nzero-lag review" {style.fill: "#fff3e0"}

runs.background -> model
runs.training -> model
runs.background -> far
model -> far
far -> openbox
far -> sensitivity
runs.simulations -> sensitivity
