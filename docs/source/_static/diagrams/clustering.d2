# Pixels to superclusters (clustering_algorithm.rst).
# Order follows coherence_native (per resolution) and
# super_cluster_native.super_cluster.supercluster_single_lag (all resolutions).
direction: down

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 1
    pad: 24
  }
}

style: {
  fill: "#ffffff"
  stroke: "#455a64"
  stroke-width: 2
  border-radius: 8
  font-color: "#263238"
  font-size: 13
  shadow: true
}

coherence: "Coherence stage, each WDM resolution" {
  label.near: top-left
  style.font-size: 14
  style.fill: "#f5f5f5"
  style.stroke: "#90a4ae"
  style.stroke-dash: 1

  pixels: "Select pixels above the\nbpp threshold" {style.fill: "#e3f2fd"}
  clusters: "Cluster neighbouring pixels\n(fragment clusters)" {style.fill: "#e8f5e9"}
  pixels -> clusters
}

supercluster: "Supercluster stage" {
  label.near: top-left
  style.font-size: 14
  style.fill: "#f5f5f5"
  style.stroke: "#90a4ae"
  style.stroke-dash: 1

  merge: "Merge clusters from\nall resolutions" {style.fill: "#fff3e0"}
  td: "Load time-delay amplitudes\nfor all their pixels" {style.fill: "#fff3e0"}
  linking: "Link clusters within TFgap;\nkeep ≥ 3 pixels above e2or" {style.fill: "#f3e5f5"}
  subnet: "Sub-network cut on the LOUD\nloudest pixels (subnet, subcut, subrho)" {style.fill: "#fce4ec"}
  defrag: "Defragment (Tgap, Fgap)\nruns before the subnet cut if pattern ≠ 0" {style.fill: "#e8eaf6"}
  merge -> td -> linking -> subnet -> defrag
}

likelihood: "Superclusters to likelihood" {style.fill: "#c8e6c9"}

coherence.clusters -> supercluster.merge
supercluster.defrag -> likelihood
