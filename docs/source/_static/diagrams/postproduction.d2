# Postproduction ranking and significance (postproduction.rst).
# Mirrors examples/postproduction/standard_analysis_10pct_workflow.yaml.
direction: down

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 1
    pad: 24
  }
}

style: {
  fill: "#ffffff"
  stroke: "#455a64"
  stroke-width: 2
  border-radius: 8
  font-color: "#263238"
  font-size: 13
  shadow: true
}

inputs: "Trigger catalogs from the production runs" {
  label.near: top-left
  style.font-size: 14
  style.fill: "#f5f5f5"
  style.stroke: "#90a4ae"
  style.stroke-dash: 1

  background: "Background\n(time slides)" {style.fill: "#e3f2fd"}
  training_sim: "Training\nsimulations" {style.fill: "#e8f5e9"}
  evaluation_sim: "Evaluation\nsimulations" {style.fill: "#fce4ec"}
  zero_lag: "Zero-lag\ntriggers" {style.fill: "#fff3e0"}
}

split: "Split background\ntraining / FAR holdout" {style.fill: "#fff3e0"}
match_train: "Match to injections,\nkeep recovered" {style.fill: "#e8f5e9"}
train: "Train XGBoost\nranking model" {style.fill: "#f3e5f5"}
far: "Score FAR holdout\n→ FAR(ρ) table" {style.fill: "#e8eaf6"}
match_eval: "Match to injections\nand score" {style.fill: "#eceff1"}
score_zero: "Score zero-lag" {style.fill: "#eceff1"}
efficiency: "Detection efficiency\nvs hrss at IFAR" {style.fill: "#e8f5e9"}
significance: "Candidate\nsignificance (IFAR)" {style.fill: "#e8f5e9"}
report: "HTML report" {style.fill: "#c8e6c9"}

inputs.background -> split
inputs.training_sim -> match_train
inputs.evaluation_sim -> match_eval
inputs.zero_lag -> score_zero

split -> train: "training"
match_train -> train
split -> far: "FAR holdout"

train -> far: {style.stroke-dash: 3}
train -> match_eval: {style.stroke-dash: 3}
train -> score_zero: {style.stroke-dash: 3}

match_eval -> efficiency
far -> efficiency
score_zero -> significance
far -> significance

efficiency -> report
significance -> report
far -> report
