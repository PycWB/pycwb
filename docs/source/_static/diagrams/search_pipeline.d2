# Per-job-segment search flow (pipeline_lifecycle.rst).
# Order follows pycwb/workflow/subflow/process_job_segment_native.py:
# trials are the outer loop, lags the inner loop.
direction: down

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 1
    pad: 24
  }
}

style: {
  fill: "#ffffff"
  stroke: "#455a64"
  stroke-width: 2
  border-radius: 8
  font-color: "#263238"
  font-size: 13
  shadow: true
}

segment: "Job segment (WaveSegment)" {
  shape: hexagon
  style.fill: "#e3f2fd"
  style.stroke: "#1e88e5"
}

load: "Read frames or generate noise" {style.fill: "#e8f5e9"}
segment -> load: {
  style.stroke: "#1e88e5"
  style.stroke-width: 2
}

trial: "Per injection trial" {
  label.near: top-left
  style.font-size: 14
  style.fill: "#f5f5f5"
  style.stroke: "#90a4ae"
  style.stroke-dash: 1

  inject: "Add this trial's injections" {style.fill: "#e8f5e9"}
  condition: "Resample, regression, whitening\n(per-detector nRMS)" {style.fill: "#fce4ec"}
  setup: "One-time setup: WDM maps, max energy,\nbpp threshold, TD cache, sky patterns" {style.fill: "#e8f5e9"}
  inject -> condition -> setup

  lag: "Per lag (incl. zero lag)" {
    label.near: top-left
    style.font-size: 14
    style.fill: "#fafafa"
    style.stroke: "#90a4ae"
    style.stroke-dash: 1

    coherence: "Coherence: select pixels,\ncluster each resolution" {style.fill: "#fff3e0"}
    supercluster: "Supercluster: TD amplitudes,\nTFgap links, subnet cut, defragment" {style.fill: "#f3e5f5"}
    likelihood: "Likelihood: sky scan,\nreconstruction, event statistics" {style.fill: "#f3e5f5"}
    output: "Post-process and write:\nwaveforms, Q-veto, catalog, progress" {style.fill: "#e8eaf6"}
    coherence -> supercluster -> likelihood -> output
  }

  setup -> lag.coherence
}

load -> trial.inject
