# Homepage overview (index.rst uses :width: 100%, about.rst natural size).
# Kept left to right and about as wide as the docs column so the banner is
# shown close to 1:1.
direction: right

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 1
    pad: 16
  }
}

style: {
  fill: "#ffffff"
  stroke: "#37474f"
  stroke-width: 2
  border-radius: 8
  font-color: "#263238"
  font-size: 14
  shadow: true
}

input: "Input data\nframes, DQ,\ninjections" {style.fill: "#e3f2fd"}
search: "Production\nsearch" {style.fill: "#e8f5e9"}
triggers: "Trigger\ncatalogs" {style.fill: "#fff3e0"}
post: "Postproduction" {style.fill: "#f3e5f5"}
background: "Background\nstatistics" {style.fill: "#e8eaf6"}
efficiency: "Detection\nefficiency" {style.fill: "#e8eaf6"}
significance: "Candidate\nsignificance" {style.fill: "#e8eaf6"}

input -> search -> triggers -> post
post -> background
post -> efficiency
post -> significance
